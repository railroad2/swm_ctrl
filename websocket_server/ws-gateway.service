[Unit]
Description=Switch Matrix WebSocket Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lgad
Group=lgad
WorkingDirectory=/home/lgad/swm_ctrl/websocket_server
ExecStart=/usr/bin/python3 /home/lgad/swm_ctrl/websocket_server/ws_gateway.py
Restart=always
RestartSec=2

# Environment tuning
Environment="PYTHONUNBUFFERED=1"
Environment="CONTROL_ALLOWED_NETWORKS=127.0.0.1/32,192.168.0.0/24"

# Journal logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
